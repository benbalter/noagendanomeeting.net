---
interface Props {
  label: string;
  value?: string;
}

const { label, value } = Astro.props;
---

<div class="flex flex-col gap-0.5 py-1 text-sm sm:flex-row sm:gap-2">
  <span class="shrink-0 text-gray-500 sm:min-w-[5.5rem] dark:text-gray-400">{label}</span>
  {value ? (
    <span class="text-gray-700 dark:text-gray-300">{value}</span>
  ) : (
    <span class="text-gray-500 italic dark:text-gray-400">(none)</span>
  )}
</div>
