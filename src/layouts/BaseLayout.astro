---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "No Agenda, No Meeting",
  description = "No agenda, no meeting — why every calendar invite needs a clear agenda, how agendaless meetings waste time, and what to do instead.",
} = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, "/");
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);
const siteUrl = Astro.site?.origin ?? "https://noagendanomeeting.net";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📅</text></svg>"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="No Agenda, No Meeting" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="A meeting without an agenda is like calling a function without documentation. Please don't send meeting invites without one."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="No Agenda, No Meeting — Please don't send meeting invites without an agenda."
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="A meeting without an agenda is like calling a function without documentation. Please don't send meeting invites without one."
    />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="canonical" href={canonicalUrl.href} />
    <meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />

    <link
      rel="preload"
      href="/fonts/dm-serif-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "No Agenda, No Meeting",
        "description": "No agenda, no meeting — why every calendar invite needs a clear agenda, how agendaless meetings waste time, and what to do instead.",
        "url": "https://noagendanomeeting.net",
        "author": {
          "@type": "Person",
          "name": "Ben Balter",
          "url": "https://openandasync.com"
        },
        "publisher": {
          "@type": "Person",
          "name": "Ben Balter"
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://noagendanomeeting.net"
        },
        "image": "https://noagendanomeeting.net/og-image.png",
        "keywords": ["meetings", "agenda", "productivity", "async work", "remote work"]
      }
    </script>
  </head>
  <body
    class="bg-neutral-50 font-sans text-base leading-relaxed text-[#1a1a2e] antialiased dark:bg-gray-900 dark:text-gray-200"
  >
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-blue-600 focus:shadow dark:focus:bg-gray-800 dark:focus:text-blue-400"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
