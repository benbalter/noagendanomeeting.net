---
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found — No Agenda, No Meeting</title>
    <meta name="robots" content="noindex" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📅</text></svg>"
    />
  </head>
  <body>
    <div
      class="flex min-h-screen items-center justify-center bg-neutral-50 p-4 text-center font-sans text-[#1a1a2e] dark:bg-gray-900 dark:text-gray-200"
    >
      <div>
        <h1 class="m-0 mb-2 text-5xl">404</h1>
        <p class="my-2 text-lg text-gray-500">This page doesn't have an agenda either.</p>
        <p class="my-2 text-lg">
          <a href="/" class="text-blue-500 underline hover:text-blue-600 dark:text-blue-400"
            >Go back to the homepage</a
          >
        </p>
      </div>
    </div>
  </body>
</html>
