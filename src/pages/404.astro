---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — No Agenda, No Meeting" noindex>
  <main id="content" class="flex min-h-screen items-center justify-center p-4 text-center">
    <div>
      <h1 class="m-0 mb-2 text-5xl">404</h1>
      <p class="my-2 text-lg text-gray-600 dark:text-gray-400">
        This page doesn't have an agenda either.
      </p>
      <p class="my-2 text-lg">
        <a href="/" class="text-blue-700 underline hover:text-blue-800 dark:text-blue-400"
          >Go back to the homepage</a
        >
      </p>
    </div>
  </main>
</BaseLayout>
